---
interface Props {
	tags: readonly string[];
}

const { tags } = Astro.props;
---

{
	tags.length > 0 && (
		<ul class="tags">
			{tags.map((tag) => (
				<li>{tag}</li>
			))}
		</ul>
	)
}

<style>
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	li {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		padding: 3px 9px;
		border-radius: 999px;
		background: var(--surface-2);
		color: var(--muted);
		border: 1px solid var(--border);
	}
</style>
