---
// Shown instead of a cover image when a project or event doesn't have one.
import type { Category, Role } from '../data/labels';

interface Props {
	tone: Category | Role;
}

const { tone } = Astro.props;
---

<div class="placeholder" data-tone={tone} aria-hidden="true">
	<svg viewBox="0 0 120 64" width="120" height="64">
		{
			tone === 'data-science' && (
				<g fill="currentColor">
					<circle cx="14" cy="50" r="3" /><circle cx="26" cy="44" r="3" /><circle cx="34" cy="47" r="3" />
					<circle cx="46" cy="36" r="3" /><circle cx="55" cy="38" r="3" /><circle cx="66" cy="28" r="3" />
					<circle cx="76" cy="30" r="3" /><circle cx="88" cy="20" r="3" /><circle cx="98" cy="22" r="3" />
					<circle cx="108" cy="12" r="3" />
					<path d="M10 54 L112 10" stroke="currentColor" stroke-width="2" stroke-dasharray="4 4" opacity="0.6" />
				</g>
			)
		}
		{
			tone === 'dashboards' && (
				<g fill="currentColor">
					<rect x="10" y="38" width="14" height="22" rx="2" /><rect x="30" y="26" width="14" height="34" rx="2" />
					<rect x="50" y="32" width="14" height="28" rx="2" /><rect x="70" y="14" width="14" height="46" rx="2" />
					<rect x="90" y="6" width="14" height="54" rx="2" />
				</g>
			)
		}
		{
			tone === 'systems' && (
				<g stroke="currentColor" stroke-width="2" fill="none">
					<path d="M28 32 H52 M68 32 H92 M60 24 V12 M60 40 V52" />
					<rect x="8" y="22" width="20" height="20" rx="4" fill="currentColor" />
					<rect x="52" y="24" width="16" height="16" rx="4" fill="currentColor" />
					<rect x="92" y="22" width="20" height="20" rx="4" fill="currentColor" />
					<circle cx="60" cy="8" r="4" fill="currentColor" />
					<circle cx="60" cy="56" r="4" fill="currentColor" />
				</g>
			)
		}
		{
			(tone === 'hosted' || tone === 'attended' || tone === 'volunteered') && (
				<g stroke="currentColor" stroke-width="2" fill="none">
					<rect x="40" y="10" width="40" height="44" rx="5" />
					<path d="M40 22 H80 M50 6 V14 M70 6 V14" />
					<circle cx="60" cy="38" r="6" fill="currentColor" />
				</g>
			)
		}
	</svg>
</div>

<style>
	.placeholder {
		display: grid;
		place-items: center;
		width: 100%;
		height: 100%;
		color: var(--c);
		background:
			radial-gradient(circle at 20% 20%, color-mix(in srgb, var(--c) 16%, transparent), transparent 60%),
			color-mix(in srgb, var(--c) 8%, var(--surface));
	}
	svg {
		opacity: 0.85;
	}
</style>
