---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import EventCard from '../components/EventCard.astro';
import ContactLinks from '../components/ContactLinks.astro';
import TagList from '../components/TagList.astro';
import { profile } from '../data/profile';
import { byNewest, categories } from '../data/labels';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(byNewest);
const featured = [...projects.filter((p) => p.data.featured), ...projects.filter((p) => !p.data.featured)].slice(0, 3);
const latestEvents = (await getCollection('blog', ({ data }) => !data.draft)).sort(byNewest).slice(0, 2);

const initials = profile.name
	.split(' ')
	.map((part) => part[0])
	.join('')
	.slice(0, 2);
---

<BaseLayout>
	<section class="hero container">
		<div class="hero-text">
			<p class="eyebrow">Hi, I'm {profile.name}{profile.location && ` · ${profile.location}`}</p>
			<h1>{profile.headline}</h1>
			{profile.bio.map((paragraph) => <p class="bio">{paragraph}</p>)}
			<div class="btn-row">
				<a class="btn btn-primary" href="/projects/">See my projects</a>
				{profile.cvUrl && <a class="btn" href={profile.cvUrl} download>Download CV</a>}
				{profile.email && <a class="btn" href={`mailto:${profile.email}`}>Get in touch</a>}
			</div>
		</div>
		<div class="portrait">
			{
				profile.photo ? (
					<img src={profile.photo} alt={`Portrait of ${profile.name}`} width="320" height="320" />
				) : (
					<span aria-hidden="true">{initials}</span>
				)
			}
		</div>
	</section>

	<section class="section container">
		<p class="eyebrow">What I work on</p>
		<h2>Skills</h2>
		<div class="skills">
			{
				profile.skills.map((group) => (
					<a class="skill-card" href={`/projects/?filter=${group.category}`}>
						<span class="badge" data-tone={group.category}>
							{categories[group.category]}
						</span>
						<TagList tags={group.items} />
						<span class="skill-link">View projects →</span>
					</a>
				))
			}
		</div>
	</section>

	{
		featured.length > 0 && (
			<section class="section container">
				<div class="section-head">
					<div>
						<p class="eyebrow">Selected work</p>
						<h2>Featured projects</h2>
					</div>
					<a href="/projects/">All projects →</a>
				</div>
				<div class="grid">
					{featured.map((project) => (
						<ProjectCard project={project} />
					))}
				</div>
			</section>
		)
	}

	{
		latestEvents.length > 0 && (
			<section class="section container">
				<div class="section-head">
					<div>
						<p class="eyebrow">Community</p>
						<h2>Recent events</h2>
					</div>
					<a href="/blog/">All events →</a>
				</div>
				<div class="stack">
					{latestEvents.map((post) => (
						<EventCard post={post} />
					))}
				</div>
			</section>
		)
	}

	<section class="section container">
		<div class="contact">
			<h2>Let's talk</h2>
			<p class="muted">{profile.contactNote}</p>
			<ContactLinks />
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		display: grid;
		gap: 32px;
		align-items: center;
		padding-top: 56px;
		padding-bottom: 32px;
	}
	@media (min-width: 800px) {
		.hero {
			grid-template-columns: 1fr 260px;
			gap: 56px;
			padding-top: 88px;
		}
	}
	.bio {
		color: var(--muted);
		font-size: 1.0625rem;
		max-width: 60ch;
	}
	.btn-row {
		margin-top: 24px;
	}
	.portrait {
		order: -1;
		width: 120px;
		aspect-ratio: 1;
		border-radius: 50%;
		overflow: hidden;
		display: grid;
		place-items: center;
		background: linear-gradient(135deg, var(--accent-soft), var(--surface-2));
		border: 1px solid var(--border);
		font-size: 2.5rem;
		font-weight: 700;
		color: var(--accent);
	}
	@media (min-width: 800px) {
		.portrait {
			order: 0;
			width: 100%;
			font-size: 4.5rem;
		}
	}
	.portrait :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.skills {
		display: grid;
		gap: 16px;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
	}
	.skill-card {
		display: flex;
		flex-direction: column;
		gap: 14px;
		padding: 20px;
		background: var(--surface);
		border: 1px solid var(--border);
		border-top: 3px solid var(--c);
		border-radius: var(--radius);
		text-decoration: none;
		color: var(--text);
		transition: transform 0.15s;
	}
	.skill-card:hover {
		transform: translateY(-2px);
		color: var(--text);
	}
	.skill-link {
		margin-top: auto;
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--accent);
	}
	.section-head {
		display: flex;
		justify-content: space-between;
		align-items: end;
		gap: 16px;
		flex-wrap: wrap;
		margin-bottom: 20px;
	}
	.section-head h2 {
		margin: 0;
	}
	.section-head a {
		font-weight: 500;
		text-decoration: none;
	}
	.stack {
		display: grid;
		gap: 16px;
	}
	.contact {
		padding: 32px;
		border-radius: var(--radius);
		background: var(--accent-soft);
		border: 1px solid var(--border);
	}
</style>
